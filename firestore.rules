rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // ================= 1. Staff Users Collection =================
    match /users/{userId} {
      // Any authenticated clinic staff member can read staff directory
      allow read: if isAuthenticated();

      // Clinic Admin can provision staff accounts, or user can record initial profile
      allow create, update: if isAuthenticated();

      // Staff deletion
      allow delete: if isAuthenticated();
    }

    // ================= 2. Patients & Clinical Sheets =================
    match /patients/{patientId} {
      allow read, write: if isAuthenticated();
    }

    // ================= 3. Sessions =================
    match /sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    // ================= 4. Expenses & Clinic Financials =================
    match /expenses/{expenseId} {
      allow read, write: if isAuthenticated();
    }

    // ================= 5. Audit Trail & Logs =================
    match /audit_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ================= 6. Dynamic Clinical & Insurance Options =================
    match /clinical_options/{category} {
      allow read, write: if isAuthenticated();
    }

    match /insurance_companies/{type} {
      allow read, write: if isAuthenticated();
    }
  }
}
