rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= Core Helper Functions =================

    // 1. Basic Authentication Check
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Profile Existence Check
    function hasProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // 3. Get User Profile Data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 4. Active Staff Verification (Fail Closed if inactive or profile missing)
    function isUserActive() {
      return hasProfile() && getUserData().active == true;
    }

    // 5. Role Helper
    function getUserRole() {
      return getUserData().role;
    }

    // 6. Role Checks
    function isAdmin() {
      return isUserActive() && getUserRole() == 'admin';
    }

    function isDoctor() {
      return isUserActive() && getUserRole() == 'doctor';
    }

    function isReceptionist() {
      return isUserActive() && getUserRole() == 'receptionist';
    }

    // ================= 1. Staff Users Collection =================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isUserActive());
      allow create: if false;
      allow delete: if false;
      allow update: if isUserActive() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.active == resource.data.active &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy;
    }

    // ================= 2. Patients & Clinical Sheets =================
    match /patients/{patientId} {
      allow read: if isUserActive();
      allow create, delete: if isAdmin() || isReceptionist();

      // Updates:
      // - Admin: full update
      // - Receptionist: can update patient demographics and billing, strictly forbidden from modifying clinicalSheet
      // - Doctor: can ONLY update clinical sheet, cannot alter patient demographics or billing
      allow update: if isUserActive() && (
        isAdmin() ||
        (
          isReceptionist() &&
          request.resource.data.clinicalSheet == resource.data.clinicalSheet
        ) ||
        (
          isDoctor() &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.phone == resource.data.phone &&
          request.resource.data.billing == resource.data.billing
        )
      );
    }

    // ================= 3. Sessions =================
    match /sessions/{sessionId} {
      allow read: if isUserActive();
      allow create, update, delete: if isAdmin() || isReceptionist();
    }

    // ================= 4. Expenses & Clinic Financials =================
    match /expenses/{expenseId} {
      allow read, create: if isAdmin() || isReceptionist();
      allow update, delete: if isAdmin();
    }

    // ================= 4.أ. Weekly Appointments Schedule (fixed recurring template) =================
    match /appointments/{apptId} {
      allow read: if isUserActive();
      allow create: if isUserActive() && (
        isAdmin() || isReceptionist() ||
        (isDoctor() && request.resource.data.doctorUid == request.auth.uid)
      ) && request.resource.data.timeSlot is string
        && request.resource.data.doctorUid is string
        && request.resource.data.patientId is string;
      allow update: if isUserActive() && (
        isAdmin() || isReceptionist() ||
        (isDoctor() && resource.data.doctorUid == request.auth.uid && request.resource.data.doctorUid == request.auth.uid)
      );
      allow delete: if isUserActive() && (
        isAdmin() || isReceptionist() ||
        (isDoctor() && resource.data.doctorUid == request.auth.uid)
      );
    }

    // ================= 5. Clinical Options & Insurance Companies =================
    match /clinical_options/{category} {
      allow read: if isUserActive();
      allow write: if isAdmin() || isReceptionist();
    }

    match /insurance_companies/{type} {
      allow read: if isUserActive();
      allow write: if isAdmin() || isReceptionist();
    }

    // ================= 6. Audit Logs =================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isUserActive() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.actionType is string &&
        request.resource.data.description is string &&
        request.resource.data.timestampRaw is number;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ================= 7. Insurance Renewal Letters (append-only archive) =================
    match /insurance_letters/{letterId} {
      allow read: if isUserActive();
      allow create: if isUserActive() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.patientId is string &&
        request.resource.data.diagnosis is string &&
        request.resource.data.sessionCount is number;
      allow update, delete: if false;
    }
  }
}
