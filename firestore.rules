rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= Core Helper Functions =================

    // 1. Basic Authentication Check
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Profile Existence Check
    function hasProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // 3. Get User Profile Data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 4. Active Staff Verification (Fail Closed if inactive or profile missing)
    function isUserActive() {
      return hasProfile() && getUserData().active == true;
    }

    // 5. Role Helper
    function getUserRole() {
      return getUserData().role;
    }

    // 6. Role Checks
    function isAdmin() {
      return isUserActive() && getUserRole() == 'admin';
    }

    function isDoctor() {
      return isUserActive() && getUserRole() == 'doctor';
    }

    function isReceptionist() {
      return isUserActive() && getUserRole() == 'receptionist';
    }

    // ================= 1. Staff Users Collection =================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isUserActive());
      allow create: if false;
      allow delete: if false;
      allow update: if isUserActive() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.active == resource.data.active &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'photoUrl', 'updatedAt'
        ]);
    }

    // ================= 2. Patients & Clinical Sheets =================
    match /patients/{patientId} {
      allow read: if isUserActive();
      allow create, delete: if isAdmin() || isReceptionist();

      // Updates:
      // - Admin: full update
      // - Receptionist: can update demographics and billing, strictly FORBIDDEN from modifying clinicalSheet
      // - Doctor: can ONLY update clinical sheet fields, CANNOT alter patient demographics or billing
      allow update: if isUserActive() && (
        isAdmin() ||
        (
          isReceptionist() &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['clinicalSheet']) == false
        ) ||
        (
          isDoctor() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'clinicalSheet', 'lastUpdatedAt', 'lastUpdatedBy'
          ])
        )
      );
    }

    // ================= 3. Sessions =================
    match /sessions/{sessionId} {
      allow read: if isUserActive();
      allow create, update, delete: if isAdmin() || isReceptionist();
    }

    // ================= 4. Expenses & Clinic Financials =================
    match /expenses/{expenseId} {
      // Accessible to Administrator and Receptionist for daily clinic operations & cash drawer
      // Doctors are completely denied read and write access
      allow read, create, update, delete: if isAdmin() || isReceptionist();
    }

    // ================= 5. Clinical Options & Insurance Companies =================
    match /clinical_options/{category} {
      allow read: if isUserActive();
      allow write: if isAdmin();
    }

    match /insurance_companies/{type} {
      allow read: if isUserActive();
      allow write: if isAdmin();
    }

    // ================= 6. Audit Logs =================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
